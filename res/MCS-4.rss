; This file provides the Retro System Specification of the Intel MCS-4 Micro
; Computer Set chip family (4001, 4002, 4003 and 4004). As line multiplexing is
; used (i.e. the meaning of the current data on a bus depends on the state) and
; I/O ports are connected to a ROM, RAM or I/O chip rather than using a central
; bus, this specification uses the following virtual bus concept:
;
; - ROM/8
;
;   This bus is used for fetching data (i.e. instructions) from a ROM by read
;   events from the CPU. A 12-bit address is used and each ROM shall recognize
;   itself by the high 4 bits. The low 8 bits represent the local byte address.
;
; - SRC
;
;   This bus is used by the CPU to transmit the address for subsequent reads or
;   writes to the ROM and RAM components as write events. This bus uses 11 bits
;   to represent the address but does not transfer data. Each RAM bank shall
;   recognize itself by the high 3 bits (which are taken from the most recent
;   DCL instruction and transmitted over the CM-RAM-x lines on the actual
;   system) while the ROM components shall ignore those high bits as the ROM
;   chip is determined by the middle 4 bits (according to the SRC instruction).
;
; - ROM_PORT/4
;
;   This bus is used for ROM port transfer. It does not use an address by
;   itself as the port address (i.e. the ROM chip) has been sent in advance by
;   the SRC bus.
;
; - RAM_PORT/4
;
;   This bus is used for RAM port transfer. An 11-bit address is used where the
;   high 3 bits refer to the current RAM bank (CM-RAM-x signals) but the port
;   address (i.e. the RAM chip) has been sent in advance by the SRC bus.
;
; - MEM/4
;
;   This bus is used for RAM memory character transfer. An 11-bit address is
;   used where the high 3 bits refer to the current RAM bank (CM-RAM-x signals)
;   but the other parts of the address (i.e. chip, register and character) have
;   been sent in advance by the SRC bus.
;
; - STAT/4
;
;   This bus is used for RAM status character transfer. An 11-bit address is
;   used where the high 3 bits refer to the current RAM bank (CM-RAM-x signals)
;   and the low 2 bits refer to the status character. The other parts of the
;   address (i.e. chip and register) have been sent in advance by the SRC bus.
;
; - IO_x/1, IN_x/1, OUT_x/1
;
;   These buses represent the individual I/O pins (i.e. I/O, input or output
;   lines) of ROM, RAM and I/O chips. No address is used.
;
; For further documentation of the MCS-4, including a descripton of its actual
; bus concept, see /doc/MCS-4.txt//.


;------------------------------------------------------------------------------
;
;  4001 ROM chip
;
;------------------------------------------------------------------------------


ROM "Intel 4001 256 x 8 bit ROM chip (load image from file)"
(
    ; buses:

    ROM/8,                          ; fetch bus
    SRC,                            ; address transmission bus
    ROM_PORT/4,                     ; ROM port read/write bus
    IO_0/1, IO_1/1, IO_2/1, IO_3/1  ; I/O lines of ROM chip
)
    ROM_FILE = "",  /* must be set by system */

    ; I/O pin configuration:
    ; - mode value 0 represents an output line (0 is sent on read)
    ; - mode value 1 represents an output line (1 is sent on read)
    ; - any other mode value represents an input line
    ; This component translates PORT/4 reads and writes to multiple IO/1
    ; reads and writes.

    IO_0_MODE = 0,
    IO_1_MODE = 0,
    IO_2_MODE = 0,
    IO_3_MODE = 0
{
    VAR SRC_PORT/1.

    CONST ROM_MEM/8(256) = $ROM_IMAGE(ROM_FILE, $INSTANCE * 256).

RESET:

    $CLEAR.  ; clear all ROM variables

ROM READ =UINT/4($INSTANCE)nnnnnnnn:

    ROM/8 = ROM_MEM/8(UINT/16(n)).

SRC xxxiiiinnnn:

    IF (UINT/4(i) == $INSTANCE)
    {
        SRC_PORT/1 = 1.
    }
    ELSE
    {
        SRC_PORT/1 = 0.
    }

ROM_PORT READ:

    IF (SRC_PORT/1 == 1)
    {
        ROM_PORT/4 = 0.

        IF ((IO_0_MODE == 1) || ((IO_0_MODE > 1) && (IO_0/1 != 0)))
        {
            ROM_PORT/4 |= 0x1.
        }

        IF ((IO_1_MODE == 1) || ((IO_1_MODE > 1) && (IO_1/1 != 0)))
        {
            ROM_PORT/4 |= 0x2.
        }

        IF ((IO_2_MODE == 1) || ((IO_2_MODE > 1) && (IO_2/1 != 0)))
        {
            ROM_PORT/4 |= 0x4.
        }

        IF ((IO_3_MODE == 1) || ((IO_3_MODE > 1) && (IO_3/1 != 0)))
        {
            ROM_PORT/4 |= 0x8.
        }
    }

ROM_PORT WRITE:

    IF (SRC_PORT/1 == 1)
    {
        IF (IO_0_MODE > 1)
        {
            IO_0/1 = ROM_PORT/4.
        }

        IF (IO_1_MODE > 1)
        {
            IO_1/1 = ROM_PORT/4 >> 1.
        }

        IF (IO_2_MODE > 1)
        {
            IO_2/1 = ROM_PORT/4 >> 2.
        }

        IF (IO_3_MODE > 1)
        {
            IO_3/1 = ROM_PORT/4 >> 3.
        }
    }
}


;------------------------------------------------------------------------------
;
;  4002 RAM bank (consists of 4 4002 chips)
;
;------------------------------------------------------------------------------


RAM "Intel 4002 4 x 320 bit RAM bank"
(
    ; buses:

    SRC,                                         ; address transmission bus
    MEM/4,                                       ; main memory character bus
    STAT/4,                                      ; status character bus
    RAM_PORT/4,                                  ; RAM port write bus
    OUT_0_0/1, OUT_0_1/1, OUT_0_2/1, OUT_0_3/1,  ; output lines of RAM chip 0
    OUT_1_0/1, OUT_1_1/1, OUT_1_2/1, OUT_1_3/1,  ; output lines of RAM chip 1
    OUT_2_0/1, OUT_2_1/1, OUT_2_2/1, OUT_2_3/1,  ; output lines of RAM chip 2
    OUT_3_0/1, OUT_3_1/1, OUT_3_2/1, OUT_3_3/1   ; output lines of RAM chip 3
)
{
    VAR ADDR { CHIP/2, REGISTER/2, CHAR/4 }

    VAR CHIP(4)
    {
        REGISTER(4) { MAIN_CHAR/4(16), STATUS_CHAR/4(4) }
    }

RESET:

    $CLEAR.  ; clear all RAM variables

SRC =UINT/3($INSTANCE)ccrrnnnn:

    ADDR:CHIP/2 = UINT/2(c).
    ADDR:REGISTER/2 = UINT/2(r).
    ADDR:CHAR/4 = UINT/4(n).

MEM READ =UINT/3($INSTANCE)xxxxxxxx:

    MEM/4 = CHIP(ADDR:CHIP):REGISTER(ADDR:REGISTER):MAIN_CHAR/4(ADDR:CHAR).

MEM WRITE =UINT/3($INSTANCE)xxxxxxxx:

    CHIP(ADDR:CHIP):REGISTER(ADDR:REGISTER):MAIN_CHAR/4(ADDR:CHAR) = MEM/4.

STAT READ =UINT/3($INSTANCE)xxxxxxnn:

    STAT/4 = CHIP(ADDR:CHIP):REGISTER(ADDR:REGISTER):STATUS_CHAR/4(UINT/2(n)).

STAT WRITE =UINT/3($INSTANCE)xxxxxxnn:

    CHIP(ADDR:CHIP):REGISTER(ADDR:REGISTER):STATUS_CHAR/4(UINT/2(n)) = STAT/4.

RAM_PORT WRITE =UINT/3($INSTANCE)xxxxxxxx:

    IF (ADDR:CHIP <= 1)
    {
        IF (ADDR:CHIP == 0)
        {
            OUT_0_0/1 = RAM_PORT/4.
            OUT_0_1/1 = RAM_PORT/4 >> 1.
            OUT_0_2/1 = RAM_PORT/4 >> 2.
            OUT_0_3/1 = RAM_PORT/4 >> 3.
        }
        ELSE
        {
            OUT_1_0/1 = RAM_PORT/4.
            OUT_1_1/1 = RAM_PORT/4 >> 1.
            OUT_1_2/1 = RAM_PORT/4 >> 2.
            OUT_1_3/1 = RAM_PORT/4 >> 3.
        }
    }
    ELSE
    {
        IF (ADDR:CHIP == 2)
        {
            OUT_2_0/1 = RAM_PORT/4.
            OUT_2_1/1 = RAM_PORT/4 >> 1.
            OUT_2_2/1 = RAM_PORT/4 >> 2.
            OUT_2_3/1 = RAM_PORT/4 >> 3.
        }
        ELSE
        {
            OUT_3_0/1 = RAM_PORT/4.
            OUT_3_1/1 = RAM_PORT/4 >> 1.
            OUT_3_2/1 = RAM_PORT/4 >> 2.
            OUT_3_3/1 = RAM_PORT/4 >> 3.
        }
    }
}


;------------------------------------------------------------------------------
;
;  4004 CPU
;
;------------------------------------------------------------------------------


CPU "Intel 4004 CPU"
(
    ; buses:

    ROM/8,       ; fetch bus
    SRC,         ; address transmission bus
    ROM_PORT/4,  ; ROM port read/write bus
    RAM_PORT/4,  ; RAM port write bus
    MEM/4,       ; main memory character bus
    STAT/4,      ; status character bus
    TEST/1       ; test input line of CPU chip
)
    ; default clock rate is 740 kHz (1.35 microseconds per cycle):

    CLOCK_RATE = 740
{
    ; registers:

    VAR A/4.        ; accumulator
    VAR CY/1.       ; carry flag (flip-flop)
    VAR REG/4(16).  ; 16 4-bit registers

    ; register pairs:

    CONST P(8) { "0P", "1P", "2P", "3P", "4P", "5P", "6P", "7P" }

    READ REG/8(x)
    {
        REG/8 = $VALUE(REG/4(2 * x), REG/4(2 * x + 1)).  ; high nibble first
    }

    WRITE REG/8(x)
    {
        $VALUE(REG/4(2 * x), REG/4(2 * x + 1)) = REG/8.  ; high nibble first
    }

    ; address stack and other CPU states:

    VAR RAM_BANK/3.  ; RAM bank currently selected by DCL

    VAR ADDRESS_STACK_PTR/2.

    VAR ADDRESS_STACK/12(4).

    PROC ADDRESS_STACK_PUSH
    {
        ADDRESS_STACK/12(ADDRESS_STACK_PTR/2) = $.

        ADDRESS_STACK_PTR/2 += 1.  ; may overflow
    }

    PROC ADDRESS_STACK_POP
    {
        ADDRESS_STACK_PTR/2 -= 1.  ; may underflow

        $ = ADDRESS_STACK/12(ADDRESS_STACK_PTR/2).
    }

RESET:

    $CLEAR.  ; clear all CPU variables

    $OPCODE_CYCLE_FREQ = CLOCK_RATE.

    $OPCODE_FETCH(ROM/8(12)).  ; 12-bit program counter, fetch from bus ROM/8

OPCODE 0000xxxx:

    IF (UINT/4(x) == 0)
    {
        $OPCODE_COMMENT("no operation").
        $OPCODE_ASM("NOP").
    }
    ELSE
    {
        $OPCODE_INVALID.
    }

    $OPCODE_CYCLES(8).

OPCODE 0001nact llllllll:

    SELECT((UINT/1(n) << 3) | (UINT/1(a) << 2) | (UINT/1(c) << 1) | UINT/1(t))
    {
    0b0000:  $OPCODE_COMMENT("jump on condition (never jump)").
    0b1000:  $OPCODE_COMMENT("jump on condition (always jump)").
    0b0100:  $OPCODE_COMMENT("jump on condition (jump if A == 0)").
    0b1100:  $OPCODE_COMMENT("jump on condition (jump if A != 0)").
    0b0010:  $OPCODE_COMMENT("jump on condition (jump if CY == 1)").
    0b1010:  $OPCODE_COMMENT("jump on condition (jump if CY == 0)").
    0b0001:  $OPCODE_COMMENT("jump on condition (jump if TEST == 0)").
    0b1001:  $OPCODE_COMMENT("jump on condition (jump if TEST == 1)").
    0b0110:  $OPCODE_COMMENT("jump on condition (jump if A == 0 or CY == 1)").
    0b1110:  $OPCODE_COMMENT("jump on condition (jump if A != 0 and CY == 0)").
    0b0101:  $OPCODE_COMMENT("jump on condition (jump if A == 0 or TEST == 0)").
    0b1101:  $OPCODE_COMMENT("jump on condition (jump if A != 0 and TEST == 1)").
    0b0011:  $OPCODE_COMMENT("jump on condition (jump if CY == 1 or TEST == 0)").
    0b1011:  $OPCODE_COMMENT("jump on condition (jump if CY == 0 and TEST == 1)").
    0b0111:  $OPCODE_COMMENT("jump on condition (jump if A == 0 or CY == 1 or TEST == 0)").
    0b1111:  $OPCODE_COMMENT("jump on condition (jump if A != 0 and CY == 0 and TEST == 1)").
    }

    $OPCODE_ASM("JCN ", P(UINT/3(r)), " ", UINT/8(l)).

    VAR T/1.

    T/1 = 0.

    IF (UINT/1(t) && (TEST/1(0) == 0))
    {
        T/1 |= 1.  ; test signal on bus TEST/1 is zero
    }

    IF (UINT/1(c) && (CY/1 == 1))
    {
        T/1 |= 1.  ; carry flag CY is set
    }

    IF (UINT/1(a) && (A/4 == 0))
    {
        T/1 |= 1.  ; accumulator A is zero
    }

    IF ((UINT/1(n) ^ T/1) != 0)
    {
        $ = ($ & 0xF00) | UINT/8(l).  ; keep current ROM page
    }

    $OPCODE_CYCLES(16).

OPCODE 0010rrr0 dddddddd:

    $OPCODE_COMMENT("fetch immediate").
    $OPCODE_ASM("FIM ", P(UINT/3(r)), " ", UINT/8(d)).

    REG/8(UINT/3(r)) = UINT/8(d).

    $OPCODE_CYCLES(16).

OPCODE 0010rrr1:

    $OPCODE_COMMENT("send register control").
    $OPCODE_ASM("SRC ", P(UINT/3(r))).

    SRC(RAM_BANK << 8 | REG/8(UINT/3(r))).

    $OPCODE_CYCLES(8).

OPCODE 0011rrr0:

    $OPCODE_COMMENT("fetch indirect").
    $OPCODE_ASM("FIN ", P(UINT/3(r))).

    REG/8(UINT/3(r)) = ROM/8(($ & 0xF00) | REG/8(0)).

    $OPCODE_CYCLES(16).

OPCODE 0011rrr1:

    $OPCODE_COMMENT("jump indirect").
    $OPCODE_ASM("JIN ", P(UINT/3(r))).

    $ = ($ & 0xF00) | REG/8(UINT/3(r)).

    $OPCODE_CYCLES(8).

OPCODE 0100hhhh llllllll:

    $OPCODE_COMMENT("jump unconditionally").
    $OPCODE_ASM("JUN ", UINT/4(h) << 8 | UINT/8(l)).

    $ = UINT/4(h) << 8 | UINT/8(l).

    $OPCODE_CYCLES(16).

OPCODE 0101hhhh llllllll:

    $OPCODE_COMMENT("jump to subroutine").
    $OPCODE_ASM("JMS ", UINT/4(h) << 8 | UINT/8(l)).

    ADDRESS_STACK_PUSH

    $ = UINT/4(h) << 8 | UINT/8(l).

    $OPCODE_CYCLES(16).

OPCODE 0110rrrr:

    $OPCODE_COMMENT("increment register").
    $OPCODE_ASM("INC ", UINT/4(r)).

    REG/4(UINT/4(r)) += 1.  ; may overflow

    $OPCODE_CYCLES(8).

OPCODE 0111rrrr llllllll:

    $OPCODE_COMMENT("increment and skip if zero").
    $OPCODE_ASM("ISZ ", UINT/4(r), " ", UINT/8(l)).

    REG/4(UINT/4(r)) += 1.  ; may overflow

    IF (REG/4(UINT/4(r)) == 0)
    {
        $ = ($ & 0xF00) | UINT/8(l).  ; keep current ROM page
    }

    $OPCODE_CYCLES(16).

OPCODE 1000rrrr:

    $OPCODE_COMMENT("add register to accumulator with carry").
    $OPCODE_ASM("ADD ", UINT/4(r)).

    A/4 += REG/4(UINT/4(r)) + CY/1.

    CY/1 = $FLAGS:CARRY.

    $OPCODE_CYCLES(8).

OPCODE 1001rrrr:

    $OPCODE_COMMENT("subtract register from accumulator with borrow").
    $OPCODE_ASM("SUB ", UINT/4(r)).

    A/4 += ~REG/4(UINT/4(r)) + (CY/1 ^ 1).

    CY/1 = $FLAGS:CARRY.

    $OPCODE_CYCLES(8).

OPCODE 1010rrrr:

    $OPCODE_COMMENT("load accumulator (from register)").
    $OPCODE_ASM("LD ", UINT/4(r)).

    A/4 = REG/4(UINT/4(r)).

    $OPCODE_CYCLES(8).

OPCODE 1011rrrr:

    $OPCODE_COMMENT("exchange register and accumulator").
    $OPCODE_ASM("XCH ", UINT/4(r)).

    A/4 <> REG/4(UINT/4(r)).

    $OPCODE_CYCLES(8).

OPCODE 1100dddd:

    $OPCODE_COMMENT("branch back and load").
    $OPCODE_ASM("BBL ", UINT/4(d)).

    ADDRESS_STACK_POP.

    A/4 = UINT/4(d).

    $OPCODE_CYCLES(8).

OPCODE 1101dddd:

    $OPCODE_COMMENT("load accumulator immediate").
    $OPCODE_ASM("LDM ", UINT/4(d)).

    A/4 = UINT/4(d).

    $OPCODE_CYCLES(8).

OPCODE 11100000:

    $OPCODE_COMMENT("write data RAM data character").
    $OPCODE_ASM("WRM").

    MEM/4(RAM_BANK/3 << 8) = A/4.

    $OPCODE_CYCLES(8).

OPCODE 11100001:

    $OPCODE_COMMENT("write RAM port").
    $OPCODE_ASM("WMP").

    RAM_PORT/4(RAM_BANK/3 << 8) = A/4.

    $OPCODE_CYCLES(8).

OPCODE 11100010:

    $OPCODE_COMMENT("write ROM port").
    $OPCODE_ASM("WRR").

    ROM_PORT/4 = A/4.

    $OPCODE_CYCLES(8).

OPCODE 11100010:

    $OPCODE_COMMENT("write program RAM (not implemented)").
    $OPCODE_ASM("WPM").

    $OPCODE_INVALID.

    $OPCODE_CYCLES(8).

OPCODE 111001ss:

    $OPCODE_COMMENT("write data RAM status character").

    SELECT(UINT/2(s))
    {
    0:  $OPCODE_ASM("WR0").
    1:  $OPCODE_ASM("WR1").
    2:  $OPCODE_ASM("WR2").
    3:  $OPCODE_ASM("WR3").
    }

    STAT/4((RAM_BANK/3 << 8) | UINT/2(s)) = A/4.

    $OPCODE_CYCLES(8).

OPCODE 11101000:

    $OPCODE_COMMENT("subtract data RAM from memory with borrow").
    $OPCODE_ASM("SBM").

    A/4 += ~MEM/4(RAM_BANK/3 << 8) + (CY/1 ^ 1).

    CY/1 = $FLAGS:CARRY.

    $OPCODE_CYCLES(8).

OPCODE 11101001:

    $OPCODE_COMMENT("read data RAM data character").
    $OPCODE_ASM("RDM").

    A/4 = MEM/4(RAM_BANK/3 << 8).

    $OPCODE_CYCLES(8).

OPCODE 11101010:

    $OPCODE_COMMENT("read ROM port").
    $OPCODE_ASM("RDR").

    A/4 = ROM_PORT/4.

    $OPCODE_CYCLES(8).

OPCODE 11101011:

    $OPCODE_COMMENT("add data RAM to accumulator with carry").
    $OPCODE_ASM("ADM").

    A/4 += MEM/4(RAM_BANK/3 << 8) + CY/1.

    CY/1 = $FLAGS:CARRY.

    $OPCODE_CYCLES(8).

OPCODE 111011ss:

    $OPCODE_COMMENT("read data RAM status character").

    SELECT(UINT/2(s))
    {
    0:  $OPCODE_ASM("RD0").
    1:  $OPCODE_ASM("RD1").
    2:  $OPCODE_ASM("RD2").
    3:  $OPCODE_ASM("RD3").
    }

    A/4 = STAT/4((RAM_BANK/3 << 8) | UINT/2(s)).

    $OPCODE_CYCLES(8).

OPCODE 11110000:

    $OPCODE_COMMENT("clear both (accumulator and carry)").
    $OPCODE_ASM("CLB").

    A/4 = 0.
    CY/1 = 0.

    $OPCODE_CYCLES(8).

OPCODE 11110001:

    $OPCODE_COMMENT("clear carry").
    $OPCODE_ASM("CLC").

    CY/1 = 0.

    $OPCODE_CYCLES(8).

OPCODE 11110010:

    $OPCODE_COMMENT("increment accumulator").
    $OPCODE_ASM("IAC").

    A/4 += 1.

    CY/1 = $FLAGS:CARRY.

    $OPCODE_CYCLES(8).

OPCODE 11110011:

    $OPCODE_COMMENT("complement carry").
    $OPCODE_ASM("CMC").

    CY/1 = ~CY/1.

    $OPCODE_CYCLES(8).

OPCODE 11110100:

    $OPCODE_COMMENT("complement accumulator").
    $OPCODE_ASM("CMA").

    A/4 = ~A/4.

    $OPCODE_CYCLES(8).

OPCODE 11110101:

    $OPCODE_COMMENT("rotate accumulator left through carry").
    $OPCODE_ASM("RAL").

    A/4 <<<= 1.  ; rotate without carry

    CY/1 ^= A/4.  ; swap least significand bit with carry
    A/4 ^= CY/1.
    CY/1 ^= A/4.

    $OPCODE_CYCLES(8).

OPCODE 11110110:

    $OPCODE_COMMENT("rotate accumulator right through carry").
    $OPCODE_ASM("RAR").

    CY/1 ^= A/4.  ; swap least significand bit with carry
    A/4 ^= CY/1.
    CY/1 ^= A/4.

    A/4 >>>= 1.  ; rotate without carry

    $OPCODE_CYCLES(8).

OPCODE 11110111:

    $OPCODE_COMMENT("transmit carry and clear").
    $OPCODE_ASM("TCC").

    A/4 = CY/1.
    CY/1 = 0.

    $OPCODE_CYCLES(8).

OPCODE 11111000:

    $OPCODE_COMMENT("decrement accumulator").
    $OPCODE_ASM("DAC").

    A/4 += 0xF.

    CY/1 = $FLAGS:CARRY.

    $OPCODE_CYCLES(8).

OPCODE 11111001:

    $OPCODE_COMMENT("transfer carry substract").
    $OPCODE_ASM("TCS").

    IF (CY/1 == 0)
    {
        A/4 = 9.
    }
    ELSE
    {
        A/4 = 10.
    }

    CY/1 = 0.

    $OPCODE_CYCLES(8).

OPCODE 11111010:

    $OPCODE_COMMENT("set carry").
    $OPCODE_ASM("STC").

    CY/1 = 1.

    $OPCODE_CYCLES(8).

OPCODE 11111011:

    $OPCODE_COMMENT("decimal adjust accumulator").
    $OPCODE_ASM("DAA").

    IF ((CY/1 == 1) || (A/4 > 9))
    {
        A/4 += 6.

        CY/1 = $FLAGS:CARRY.
    }

    $OPCODE_CYCLES(8).

OPCODE 11111100:

    $OPCODE_COMMENT("keyboard process").
    $OPCODE_ASM("KBP").

    IF (A/4 == 0x4)
    {
        A/4 = 0x3.
    }
    ELIF (A/4 == 0x8)
    {
        A/4 = 0x4.
    }
    ELIF (A/4 > 2)
    {
        A/4 = 0xF.
    }

    $OPCODE_CYCLES(8).

OPCODE 11111101:

    $OPCODE_COMMENT("designate command line").
    $OPCODE_ASM("DCL").

    RAM_BANK/3 = A/4.

    $OPCODE_CYCLES(8).

OPCODE 1111111x:

    $OPCODE_INVALID.
    $OPCODE_CYCLES(8).
}
