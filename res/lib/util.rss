DEVICE STDIO "7-bit ASCII standard input and output"

` This device is assigned to a 7-bit bus which gets a single ASCII character
` from stdin on read by a blocking call and puts a single ASCII character to
` stdout on write.

    STDIO/7
{
STDIO READ:

    STDIO/7 = $STDIO_GETCHAR.  ; blocking call

STDIO WRITE:

    $STDIO_PUTCHAR = STDIO/7.
}


DEVICE BUS_PIN_MAPPER "bus/pin event mapper (up to 32 pins)"

` This generic utility devices maps events on a bus with a 5-bit address to the
` corresponding pin (address 00H is mapped to PIN_01, address 01H to PIN_02 and
` so on) and vice versa.

    BUS/0,
    PIN_01/0, PIN_02/0, PIN_03/0, PIN_04/0,
    PIN_05/0, PIN_06/0, PIN_07/0, PIN_08/0,
    PIN_09/0, PIN_10/0, PIN_11/0, PIN_12/0,
    PIN_13/0, PIN_14/0, PIN_15/0, PIN_16/0,
    PIN_17/0, PIN_18/0, PIN_19/0, PIN_20/0,
    PIN_21/0, PIN_22/0, PIN_23/0, PIN_24/0,
    PIN_25/0, PIN_26/0, PIN_27/0, PIN_28/0,
    PIN_29/0, PIN_30/0, PIN_31/0, PIN_32/0
{
BUS nn:

    SELECT (UINT/2(n))
    {
    0x00:  PIN_01/0(0).    0x01:  PIN_02/0(0).
    0x02:  PIN_03/0(0).    0x03:  PIN_04/0(0).
