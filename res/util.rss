DEVICE "4 line bus to pin event mapper" (BUS, PIN_1, PIN_2, PIN_3, PIN_4)
{
BUS nn:

    SELECT (UINT/2(n))
    {
    0:  PIN_1(0).
    1:  PIN_2(0).
    2:  PIN_3(0).
    3:  PIN_4(0).
    }
}


DEVICE "4 line pin to bus event mapper" (PIN_1, PIN_2, PIN_3, PIN_4, BUS)
{
PIN_1:  BUS(0).
PIN_2:  BUS(1).
PIN_3:  BUS(2).
PIN_4:  BUS(3).
}


KEYBOARD "STDIN (7-bit ASCII standard input)" (DATA/7)
{
DATA READ:

    DATA/7 = $STDIO_GETCHAR.  ; blocking call
}


SCREEN "STDOUT (7-bit ASCII standard ouput)" (DATA/7)
{
DATA WRITE:

    $STDIO_PUTCHAR = DATA/7.
}
