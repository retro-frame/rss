        [0] $OPCODE("NDA").
        [1] $OPCODE("NDB").
        [2] $OPCODE("NDC").
        [3] $OPCODE("NDD").
        [4] $OPCODE("NDE").
        [5] $OPCODE("NDH").
        [6] $OPCODE("NDL").
        }

        REG/8(A) &= REG/8(r/3).
    }
    ELSE
    {
        $COMMENT("and memory").
        $OPCODE("NDM").

        REG/8(A) &= MEM/8(HL/14).

        $CYCLES(6).  ; total cycles will be 16
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

    $CYCLES(10).
