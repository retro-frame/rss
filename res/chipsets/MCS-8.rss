    $CYCLES(6).
    RETURN.

[FETCH 00000100 bbbbbbbb]

    $COMMENT("add immediate").
    $OPERAND($HEX(b/8)).
    $OPCODE("ADI").

    REG/8(A) += b/8.

    $FLAGS(F/4, PF, SF, ZF, CF).

    $CYCLES(16).
    RETURN.

[FETCH 00001100 bbbbbbbb]

    $COMMENT("add immediate with carry").
