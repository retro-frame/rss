CPU INTEL_8008 "Intel MCS-8 8008 CPU"

    MEM/8,            ; 8-bit memory bus
    PORT/8,           ; 8-bit port bus
    INT/8,            ; 8-bit interrupt request bus
    CLOCK_RATE = 500  ; 500 kHz default clock rate (2 microseconds/cycle)
{
    ; registers:

    VAR REG/8(7) A, B, C, D, E, H, L.

    VAR F/4.  ; flags in order: P (parity), S (sign), Z (zero), C (carry)

    READ HL/14
    {
        HL/14 = UINT/14(REG/8(H), REG/8(L)).
    }

    ; address stack:

    VAR ADDRESS_STACK_PTR/3.

    VAR ADDRESS_STACK/14(8).

    MACRO ADDRESS_STACK_PUSH
    {
        ADDRESS_STACK/14(ADDRESS_STACK_PTR/3) = $.

        ADDRESS_STACK_PTR/3 += 1.  ; may overflow
    }

    MACRO ADDRESS_STACK_POP
    {
        ADDRESS_STACK_PTR/3 -= 1.  ; may underflow

        $ = ADDRESS_STACK/14(ADDRESS_STACK_PTR/3).
    }

RESET:

    $CLEAR.  ; clear all CPU variables

    $OPCODE_CYCLE_FREQ = CLOCK_RATE.

    $OPCODE_FETCH(MEM/8, 14).  ; 14-bit program counter, fetch from bus MEM/8

OPCODE 00rrr000:

    SELECT (r)
    {
    0:

        $OPCODE_COMMENT("halt").
        $OPCODE_ASM("HLT").

        $HALT.
        $OPCODE_CYCLES(8).

    7:

        $OPCODE_INVALID.
        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        $OPCODE_COMMENT("increment register").

        SELECT (r)
        {
        1:  $OPCODE_ASM("INB").
        2:  $OPCODE_ASM("INC").
        3:  $OPCODE_ASM("IND").
        4:  $OPCODE_ASM("INE").
        5:  $OPCODE_ASM("INH").
        6:  $OPCODE_ASM("INL").
        }

        REG/8(r) += 1.

        $FLAGS(F/4, PF, SF, ZF, -).

        $OPCODE_CYCLES(10).
    }

OPCODE 00rrr001:

    SELECT (r)
    {
    0:

        $OPCODE_COMMENT("halt").
        $OPCODE_ASM("HLT").

        $HALT.
        $OPCODE_CYCLES(8).

    7:

        $OPCODE_INVALID.
        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        $OPCODE_COMMENT("decrement register").

        SELECT (r)
        {
        1:  $OPCODE_ASM("DEB").
        2:  $OPCODE_ASM("DEC").
        3:  $OPCODE_ASM("DED").
        4:  $OPCODE_ASM("DEE").
        5:  $OPCODE_ASM("DEH").
        6:  $OPCODE_ASM("DEL").
        }

        REG/8(r) += 1.

        $FLAGS(F/4, PF, SF, ZF, -).

        $OPCODE_CYCLES(10).
    }

OPCODE 00000010:

    $OPCODE_COMMENT("rotate left").
    $OPCODE_ASM("RLC").

    REG/8(A) <<<= 1.

    $FLAGS(F/4, -, -, -, REG/8(A) & 1).

    $OPCODE_CYCLES(10).

OPCODE 000cc011:

    $OPCODE_COMMENT("return if condition is false").

    SELECT (r)
    {
    0:  $OPCODE_ASM("RFC").
    1:  $OPCODE_ASM("RFZ").
    2:  $OPCODE_ASM("RFS").
    3:  $OPCODE_ASM("RFP").
    }

    IF ((F/4 & (1 << c)) == 0)
    {
        ADDRESS_STACK_POP.

        $OPCODE_CYCLES(4).  ; total clocks will be 10
    }

    $OPCODE_CYCLES(6).

OPCODE 001cc011:

    $OPCODE_COMMENT("return if condition is true").

    SELECT (r)
    {
    0:  $OPCODE_ASM("RTC").
    1:  $OPCODE_ASM("RTZ").
    2:  $OPCODE_ASM("RTS").
    3:  $OPCODE_ASM("RTP").
    }

    IF (F/4 & (1 << c) != 0)
    {
        ADDRESS_STACK_POP.

        $OPCODE_CYCLES(4).  ; total clocks will be 10
    }

    $OPCODE_CYCLES(6).

OPCODE 00000100 bbbbbbbb:

    $OPCODE_COMMENT("add immediate").
    $OPCODE_ASM("ADI").

    REG/8(A) += b.

    $FLAGS(F/4, PF, SF, ZF, CF).

    $OPCODE_CYCLES(16).

OPCODE 00001100 bbbbbbbb:

    $OPCODE_COMMENT("add immediate with carry").
    $OPCODE_ASM("ACI").

    REG/8(A) += b + (F/4 & 1).

    $FLAGS(F/4, PF, SF, ZF, CF).

    $OPCODE_CYCLES(16).

OPCODE 00010100 bbbbbbbb:

    $OPCODE_COMMENT("subtract immediate").
    $OPCODE_ASM("SUI").

    REG/8(A) -= b.

    $FLAGS(F/4, PF, SF, ZF, CF).

    $OPCODE_CYCLES(16).

OPCODE 00011100 bbbbbbbb:

    $OPCODE_COMMENT("subtract immediate with borrow").
    $OPCODE_ASM("SBI").

    REG/8(A) -= b + (F/4 & 1).

    $FLAGS(F/4, PF, SF, ZF, CF).

    $OPCODE_CYCLES(16).

OPCODE 001x0010:

    $OPCODE_INVALID.
    $OPCODE_CYCLES(10).

OPCODE 00100100 bbbbbbbb:

    $OPCODE_COMMENT("AND immediate").
    $OPCODE_ASM("NDI").

    REG/8(A) &= b.

    $FLAGS(F/4, PF, SF, ZF, CF).

    $OPCODE_CYCLES(16).

OPCODE 00101100 bbbbbbbb:

    $OPCODE_COMMENT("XOR immediate").
    $OPCODE_ASM("XRI").

    REG/8(A) ^= b.

    $FLAGS(F/4, PF, SF, ZF, CF).

    $OPCODE_CYCLES(16).

OPCODE 00110100 bbbbbbbb:

    $OPCODE_COMMENT("OR immediate").
    $OPCODE_ASM("ORI").

    REG/8(A) |= b.

    $FLAGS(F/4, PF, SF, ZF, CF).

    $OPCODE_CYCLES(16).

OPCODE 00111100 bbbbbbbb:

    $OPCODE_COMMENT("compare immediate").
    $OPCODE_ASM("CPI").

    REG/8(A) - b.

    $FLAGS(F/4, PF, SF, ZF, CF).

    $OPCODE_CYCLES(16).

OPCODE 00aaa101:

    $OPCODE_COMMENT("restart").
    $OPCODE_ASM("RST").

    ADDRESS_STACK_PUSH.

    $ = a << 3.

    $OPCODE_CYCLES(10).

OPCODE 00rrr110 bbbbbbbb:

    IF (r < 7)
    {
        $OPCODE_COMMENT("load register immediate").

        SELECT (r)
        {
        0:  $OPCODE_ASM("LAI").
        1:  $OPCODE_ASM("LBI").
        2:  $OPCODE_ASM("LCI").
        3:  $OPCODE_ASM("LDI").
        4:  $OPCODE_ASM("LEI").
        5:  $OPCODE_ASM("LHI").
        6:  $OPCODE_ASM("LLI").
        }

        REG/8(r) = b.

        $OPCODE_CYCLES(16).
    }
    ELSE
    {
        $OPCODE_COMMENT("load register immediate").
        $OPCODE_ASM("LMI").

        MEM/8(HL/14) = b.

        $OPCODE_CYCLES(18).
    }

OPCODE 00xxx111:

    $OPCODE_COMMENT("unconditional return").
    $OPCODE_ASM("RET").

    ADDRESS_STACK_POP.

    $OPCODE_CYCLES(10).

OPCODE 00001010:

    $OPCODE_COMMENT("rotate right").
    $OPCODE_ASM("RRC").

    $FLAGS(F/4, -, -, -, REG/8(A) & 1).

    REG/8(A) >>>= 1.

    $OPCODE_CYCLES(10).

OPCODE 00010010:

    $OPCODE_COMMENT("rotate arithmetic left").
    $OPCODE_ASM("RAL").

    REG/8(A) <<<= 1.

    F:C/1 ^= REG/8(A).
    REG/8(A) ^= F:C/1.
    F:C/1 ^= REG/8(A).

    $OPCODE_CYCLES(10).

OPCODE 00011010:

    $OPCODE_COMMENT("rotate arithmetic right").
    $OPCODE_ASM("RAR").

    F:C/1 ^= REG/8(A).
    REG/8(A) ^= F:C/1.
    F:C/1 ^= REG/8(A).

    REG/8(A) >>>= 1.

    $OPCODE_CYCLES(10).

OPCODE 010cc000 llllllll xxhhhhhh:

    $OPCODE_COMMENT("jump if condition is false").

    SELECT (r)
    {
    0:  $OPCODE_ASM("JFC").
    1:  $OPCODE_ASM("JFZ").
    2:  $OPCODE_ASM("JFS").
    3:  $OPCODE_ASM("JFP").
    }

    IF ((F/4 & (1 << c)) == 0)
    {
        $ = UINT/14(h, l).

        $OPCODE_CYCLES(4).  ; total clocks will be 22
    }

    $OPCODE_CYCLES(18).

OPCODE 011cc000 llllllll xxhhhhhh:

    $OPCODE_COMMENT("jump if condition is true").

    SELECT (r)
    {
    0:  $OPCODE_ASM("JTC").
    1:  $OPCODE_ASM("JTZ").
    2:  $OPCODE_ASM("JTS").
    3:  $OPCODE_ASM("JTP").
    }

    IF (F/4 & (1 << c) != 0)
    {
        $ = UINT/14(h, l).

        $OPCODE_CYCLES(4).  ; total clocks will be 22
    }

    $OPCODE_CYCLES(18).

OPCODE 01mmmmm1:

    IF (m < 8)
    {
        ; INP (input from port):

        REG/8(A) = PORT/8(m).

        $OPCODE_CYCLES(16).
    }
    ELSE
    {
        ; OUT (output to port):

        PORT/8(m) = REG/8(A).

        $OPCODE_CYCLES(12).
    }

OPCODE 010cc010 llllllll xxhhhhhh:

    ; CFc (call if condition is false):

    IF ((F/4 & (1 << c)) == 0)
    {
        ADDRESS_STACK_PUSH.

        $ = UINT/14(h, l).

        $OPCODE_CYCLES(4).  ; total clocks will be 22
    }

    $OPCODE_CYCLES(18).

OPCODE 011cc010 llllllll xxhhhhhh:

    ; CTc (call if condition is true):

    IF (F/4 & (1 << c) != 0)
    {
        ADDRESS_STACK_PUSH.

        $ = UINT/14(h, l).

        $OPCODE_CYCLES(4).  ; total clocks will be 22
    }

    $OPCODE_CYCLES(18).

OPCODE 01xxx100 llllllll xxhhhhhh:

    ; JMP (unconditional jump):

    $ = UINT/14(h, l).

    $OPCODE_CYCLES(22).

OPCODE 01xxx110 llllllll xxhhhhhh:

    ; CAL (unconditional call):

    ADDRESS_STACK_PUSH.

    $ = UINT/14(h, l).

    $OPCODE_CYCLES(22).

OPCODE 10000rrr:

    IF (r < 7)
    {
        ; ADr (add register):

        REG/8(A) += REG/8(r).

        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        ; ADM (add memory):

        REG/8(A) += MEM/8(HL/14).

        $OPCODE_CYCLES(16).
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

OPCODE 10001rrr:

    IF (r < 7)
    {
        ; ACr (add register with carry):

        REG/8(A) += REG/8(r) + (F/4 & 1).

        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        ; ACM (add memory with carry):

        REG/8(A) += MEM/8(HL/14) + (F/4 & 1).

        $OPCODE_CYCLES(16).
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

OPCODE 10010rrr:

    IF (r < 7)
    {
        ; SUr (sub register):

        REG/8(A) -= REG/8(r).

        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        ; SUM (sub memory):

        REG/8(A) -= MEM/8(HL/14).

        $OPCODE_CYCLES(16).
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

OPCODE 10011rrr:

    IF (r < 7)
    {
        ; SBr (sub register with borrow):

        REG/8(A) -= REG/8(r) + (F/4 & 1).

        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        ; SBM (sub memory with borrow):

        REG/8(A) -= MEM/8(HL/14) + (F/4 & 1).

        $OPCODE_CYCLES(16).
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

OPCODE 10100rrr:

    IF (r < 7)
    {
        ; NDr (and register):

        REG/8(A) &= REG/8(r).

        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        ; NDM (and memory):

        REG/8(A) &= MEM/8(HL/14).

        $OPCODE_CYCLES(16).
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

OPCODE 10101rrr:

    IF (r < 7)
    {
        ; XRr (xor register):

        REG/8(A) ^= REG/8(r).

        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        ; XRM (xor memory):

        REG/8(A) ^= MEM/8(HL/14).

        $OPCODE_CYCLES(16).
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

OPCODE 10110rrr:

    IF (r < 7)
    {
        ; ORr (or register):

        REG/8(A) |= REG/8(r).

        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        ; ORM (or memory):

        REG/8(A) |= MEM/8(HL/14).

        $OPCODE_CYCLES(16).
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

OPCODE 10111rrr:

    IF (r < 7)
    {
        ; CPr (compare register):

        REG/8(A) - REG/8(r).

        $OPCODE_CYCLES(10).
    }
    ELSE
    {
        ; CPM (compare memory):

        REG/8(A) - MEM/8(HL/14).

        $OPCODE_CYCLES(16).
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

OPCODE 11dddsss:

    IF (d < 7) && (s < 7))
    {
        ; Lds (load register from register):

        REG/8(d) = REG/8(s).

        $OPCODE_CYCLES(10).
    }
    ELIF (d < 7)
    {
        ; LdM (load register from memory):

        REG/8(d) = MEM/8(HL/14).

        $OPCODE_CYCLES(16).
    }
    ELIF (s < 7)
    {
        ; LMs (load memory from register):

        MEM/8(HL/14) = REG/8(d).

        $OPCODE_CYCLES(16).
    }
    ELSE
    {
        ; HLT (halt):

        $HALT.
        $OPCODE_CYCLES(8).
    }

INT:

    ; interrupt request:

    $OPCODE_FETCH_ONCE(INT/8).  ; fetch one instruction, do not advance $
}
