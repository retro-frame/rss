[FETCH 10000rrr]

    IF (r/3 < 7)
    {
        $COMMENT("add register").

        SELECT (r/3)
        {
        [0] $OPCODE("ADA").
        [1] $OPCODE("ADB").
        [2] $OPCODE("ADC").
        [3] $OPCODE("ADD").
        [4] $OPCODE("ADE").
        [5] $OPCODE("ADH").
        [6] $OPCODE("ADL").
        }

        REG/8(A) += REG/8(r/3).
    }
    ELSE
    {
        $COMMENT("add memory").
        $OPCODE("ADM").

        REG/8(A) += MEM/8(HL/14).

        $CYCLES(6).  ; total cycles will be 16
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

    $CYCLES(10).
    RETURN.

[FETCH 10001rrr]

    IF (r/3 < 7)
