[FETCH 01mmmmm1]

    IF (m/5 < 8)
    {
        $COMMENT("input from port").
        $OPERAND($DEC(UINT(m/5))).
        $OPCODE("INP").

        REG/8(A) = PORT/8(m/5).

        $CYCLES(4).  ; total cycles will be 16
    }
    ELSE
    {
        $COMMENT("output to port").
        $OPERAND($DEC(UINT(m/5))).
        $OPCODE("OUT").

        PORT/8(m/5) = REG/8(A).

    }

    $CYCLES(12).
    RETURN.

[FETCH 010cc010 llllllll ??hhhhhh]

