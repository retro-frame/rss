[FETCH 00aaa101]

    $COMMENT("restart").
    $OPERAND($HEX(UINT/14(a/3 << 3))).
    $OPCODE("RST").

    STACK_PUSH.

    $ = a/3 << 3.

    $CYCLES(10).
    RETURN.

[FETCH 00rrr110 bbbbbbbb]

    $OPERAND($HEX(b/8)).

    IF (r/3 < 7)
    {
        $COMMENT("load register immediate").

        SELECT (r/3)
        {
        [0] $OPCODE("LAI").
        [1] $OPCODE("LBI").
        [2] $OPCODE("LCI").
        [3] $OPCODE("LDI").
        [4] $OPCODE("LEI").
        [5] $OPCODE("LHI").
        [6] $OPCODE("LLI").
        }

        REG/8(r/3) = b/8.
    }
    ELSE
    {
        $COMMENT("load memory immediate").
        $OPCODE("LMI").

        MEM/8(HL/14) = b/8.

        $CYCLES(2).  ; total cycles will be 18
    }

    $CYCLES(16).
    RETURN.

[FETCH 00???111]

    $COMMENT("unconditional return").
    $OPCODE("RET").

    STACK_POP.

    $CYCLES(10).
    RETURN.

[FETCH 00001010]

    $COMMENT("rotate right").
    $OPCODE("RRC").

    $FLAGS(F/4, ?, ?, ?, REG/8(A) & 1).

    REG/8(A) >>>= 1.

    $CYCLES(10).
    RETURN.

[FETCH 00010010]

    $COMMENT("rotate arithmetic left").
    $OPCODE("RAL").

    REG/8(A) <<<= 1.

    F:C/1 ^= REG/8(A).
    REG/8(A) ^= F:C/1.
    F:C/1 ^= REG/8(A).

    $CYCLES(10).
    RETURN.

[FETCH 00011010]

    $COMMENT("rotate arithmetic right").
    $OPCODE("RAR").

    F:C/1 ^= REG/8(A).
    REG/8(A) ^= F:C/1.
    F:C/1 ^= REG/8(A).

    REG/8(A) >>>= 1.

    $CYCLES(10).
    RETURN.

[FETCH 010cc000 llllllll ??hhhhhh]

    $COMMENT("jump if condition is false").
    $OPERAND($HEX(UINT/14(h/8, l/8))).

    SELECT (c/2)
    {
    [0] $OPCODE("JFC").
    [1] $OPCODE("JFZ").
    [2] $OPCODE("JFS").
    [3] $OPCODE("JFP").
    }

    IF (!(F/4 & (1 << c/2)))
    {
        $ = UINT/14(h/8, l/8).

        $CYCLES(4).  ; total cycles will be 22
    }

    $CYCLES(18).
    RETURN.

[FETCH 011cc000 llllllll ??hhhhhh]

    $COMMENT("jump if condition is true").
    $OPERAND($HEX(UINT/14(h/8, l/8))).

    SELECT (c/2)
    {
    [0] $OPCODE("JTC").
    [1] $OPCODE("JTZ").
