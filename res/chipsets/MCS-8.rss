[FETCH 11dddsss]

    IF ((d/3 < 7) && (s/3 < 7))
    {
        $COMMENT("load register from register").

        SELECT ((d/3 << 4) | s/3)
        {
        [0x00]  $OPCODE("NOP"). [0x01]  $OPCODE("LAB"). [0x02]  $OPCODE("LAC").
        [0x03]  $OPCODE("LAD"). [0x04]  $OPCODE("LAE"). [0x05]  $OPCODE("LAH").
        [0x06]  $OPCODE("LAL").
        [0x10]  $OPCODE("LBA"). [0x11]  $OPCODE("LBB"). [0x12]  $OPCODE("LBC").
        [0x13]  $OPCODE("LBD"). [0x14]  $OPCODE("LBE"). [0x15]  $OPCODE("LBH").
        [0x16]  $OPCODE("LBL").
        [0x20]  $OPCODE("LCA"). [0x21]  $OPCODE("LCB"). [0x22]  $OPCODE("LCC").
        [0x23]  $OPCODE("LCD"). [0x24]  $OPCODE("LCE"). [0x25]  $OPCODE("LCH").
        [0x26]  $OPCODE("LCL").
        [0x30]  $OPCODE("LDA"). [0x31]  $OPCODE("LDB"). [0x32]  $OPCODE("LDC").
        [0x33]  $OPCODE("LDD"). [0x34]  $OPCODE("LDE"). [0x35]  $OPCODE("LDH").
        [0x36]  $OPCODE("LDL").
        [0x40]  $OPCODE("LEA"). [0x41]  $OPCODE("LEB"). [0x42]  $OPCODE("LEC").
        [0x43]  $OPCODE("LED"). [0x44]  $OPCODE("LEE"). [0x45]  $OPCODE("LEH").
        [0x46]  $OPCODE("LEL").
        [0x50]  $OPCODE("LHA"). [0x51]  $OPCODE("LHB"). [0x52]  $OPCODE("LHC").
        [0x53]  $OPCODE("LHD"). [0x54]  $OPCODE("LHE"). [0x55]  $OPCODE("LHH").
        [0x56]  $OPCODE("LHL").
        [0x60]  $OPCODE("LLA"). [0x61]  $OPCODE("LLB"). [0x62]  $OPCODE("LLC").
        [0x63]  $OPCODE("LLD"). [0x64]  $OPCODE("LLE"). [0x65]  $OPCODE("LLH").
        [0x66]  $OPCODE("LLL").
        }

        REG/8(d/3) = REG/8(s/3).

        $CYCLES(2).  ; total cycles will be 10
    }
    ELIF (d/3 < 7)
    {
        $COMMENT("load register from memory").

        SELECT (d/3)
        {
        [0] $OPCODE("LAM").
        [1] $OPCODE("LBM").
        [2] $OPCODE("LCM").
        [3] $OPCODE("LDM").
        [4] $OPCODE("LEM").
        [5] $OPCODE("LHM").
        [6] $OPCODE("LLM").
        }

        REG/8(d/3) = MEM/8(HL/14).

        $CYCLES(8).  ; total cycles will be 10
    }
    ELIF (s < 7)
    {
        $COMMENT("load memory from register").

        SELECT (s/3)
        {
        [0] $OPCODE("LMA").
        [1] $OPCODE("LMB").
        [2] $OPCODE("LMC").
        [3] $OPCODE("LMD").
        [4] $OPCODE("LME").
        [5] $OPCODE("LMH").
        [6] $OPCODE("LML").
        }

        MEM/8(HL/14) = REG/8(d/3).

        $CYCLES(8).  ; total cycles will be 10
    }
    ELSE
    {
        $COMMENT("compare memory").
        $OPCODE("CPM").

        REG/8(A) - MEM/8(HL/14).

        $CYCLES(6).  ; total cycles will be 16
    }

    $FLAGS(F/4, PF, SF, ZF, CF).

    $CYCLES(10).
    RETURN.

    IF (d < 7) && (s < 7))
    {
        ; Lds (load register from register):

        REG/8(d) = REG/8(s).

        $CYCLES(10).
    }
    ELIF (d < 7)
    {
        ; LdM (load register from memory):

        REG/8(d) = MEM/8(HL/14).

        $CYCLES(16).
    }
    ELIF (s < 7)
    {
        ; LMs (load memory from register):

        MEM/8(HL/14) = REG/8(d).

        $CYCLES(16).
    }
    ELSE
    {
        $COMMENT("halt").
        $OPCODE("HLT").

        $HALT.
    }

    $CYCLES(8).
    RETURN.

[EVENT INT/8]

    ; interrupt request:

    $SINGLE_FETCH(INT/8).  ; fetch one instruction byte (does not use $)
