CPU INTEL_8008 "Intel MCS-8 8008 CPU"

    #CHIP #CPU #INTEL #MCS-8 #8008

` This CPU component is part of the Intel MCS-8 Micro Computer Set. It uses an
` 8-bit memory bus using a 14-bit address and a separate 8-bit I/O bus using
` a 5-bit adress where ports 0..7 are dedicated to input and ports 8..32 to
` output. Other devices should be connected either using memory bus mapping or
` the I/O bus using predefined port numbers. For subroutine calls, the 8008 CPU
` uses an internal stack of 8 elements (including the current PC).
(
    CLOCK_RATE = 500,  ; 500 kHz default clock rate (2 microseconds/cycle)
    MEM/8,             ; 8-bit memory bus
    PORT/8,            ; 8-bit port bus
    INT/8              ; 8-bit interrupt request bus
)
{
    ; registers:

    VAR REG/8(7) A, B, C, D, E, H, L.

    VAR F/4.  ; flags in order: P (parity), S (sign), Z (zero), C (carry)

    READ HL/14
    {
        HL/14 = UINT/14(REG/8(H), REG/8(L)).
    }

    ; address stack:

    VAR STACK_PTR/3.

    VAR STACK/14(8).

    STACK_PUSH
    {
        STACK_PTR/3 += 1.  ; may overflow
    }

    STACK_POP
    {
        STACK_PTR/3 -= 1.  ; may underflow

        $ = STACK/14(STACK_PTR/3).
    }

    RETURN
    {
        STACK/14(STACK_PTR/3) = $.
    }

[RESET]

    $CLEAR.  ; clear all CPU variables

    $CYCLE_FREQ = CLOCK_RATE.

    $FETCH/14(MEM/8).  ; 14-bit program counter, fetch from bus MEM/8

    $ = 0x0000.  ; start fetching at address 0000H
    RETURN.

[FETCH 00rrr000]

    SELECT (r/3)
    {
    [0] $COMMENT("halt").
        $OPCODE("HLT").

        $HALT.

    [7] $OPCODE_INVALID.

        $CYCLES(2).  ; total cycles will be 10
    }
    ELSE
    {
        $COMMENT("increment register").

        SELECT (r/3)
        {
        [1] $OPCODE("INB").
        [2] $OPCODE("INC").
        [3] $OPCODE("IND").
        [4] $OPCODE("INE").
        [5] $OPCODE("INH").
        [6] $OPCODE("INL").
        }

        REG/8(r/3) += 1.

        $FLAGS(F/4, PF, SF, ZF, ?).

        $CYCLES(2).  ; total cycles will be 10
    }

    $CYCLES(8).
    RETURN.

[FETCH 00rrr001]

    SELECT (r/3)
    {
    [0] $COMMENT("halt").
        $OPCODE("HLT").

        $HALT.

    [7] $OPCODE_INVALID.

        $CYCLES(2).  ; total cycles will be 10
    }
    ELSE
    {
        $COMMENT("decrement register").

        SELECT (r)
        {
        [1] $OPCODE("DEB").
        [2] $OPCODE("DEC").
        [3] $OPCODE("DED").
        [4] $OPCODE("DEE").
        [5] $OPCODE("DEH").
        [6] $OPCODE("DEL").
        }

        REG/8(r) += 1.

        $FLAGS(F/4, PF, SF, ZF, ?).

        $CYCLES(2).  ; total cycles will be 10
    }

    $CYCLES(8).
    RETURN.

[FETCH 00000010]

    $COMMENT("rotate left").
    $OPCODE("RLC").

    REG/8(A) <<<= 1.

    $FLAGS(F/4, ?, ?, ?, REG/8(A) & 1).

    $CYCLES(10).
    RETURN.

[FETCH 000cc011]

    $COMMENT("return if condition is false").

    SELECT (c/2)
    {
    [0] $OPCODE("RFC").
    [1] $OPCODE("RFZ").
    [2] $OPCODE("RFS").
    [3] $OPCODE("RFP").
    }

    IF (!(F/4 & (1 << c/2)))
    {
        STACK_POP.

        $CYCLES(4).  ; total cycles will be 10
    }

    $CYCLES(6).
    RETURN.

[FETCH 001cc011]

    $COMMENT("return if condition is true").

