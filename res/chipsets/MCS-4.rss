; This file provides the Retro System Specification of the Intel MCS-4 Micro
; Computer Set chip family (4001, 4002, 4003 and 4004). As line multiplexing is
; used (i.e. the meaning of the current data on a bus depends on the state) and
; I/O ports are connected to a ROM, RAM or I/O chip rather than using a central
; bus, this specification uses the following virtual bus concept:
;
; - FETCH/8
;
;   This bus is used for fetching data (i.e. instructions) from a ROM chip by
;   read events from the CPU. A 12-bit address is used and each ROM chip shall
;   recognize itself by the high 4 bits. The low 8 bits represent the byte
;   address within that ROM chip (i.e. on that ROM page).
;
; - SRC
;
;   This bus is used by the CPU to transmit the address for subsequent reads or
;   writes to the RAM and ROM chips as events by a SRC (send register control)
;   instruction. It uses 11 bits to represent the address but does not transfer
;   data. Each RAM bank shall recognize itself by the high 3 bits (which are
;   set by a DCL instruction and transmitted over the CM-RAM-x lines on the
;   actual system) while the ROM chips shall ignore those high bits as the ROM
;   chip is determined by the middle 4 bits for subsequent I/O.
;
; - ROM_PORT/4
;
;   This bus is used for ROM port transfer. No address is used as the port
;   address (i.e. the ROM chip) has been sent in advance by the SRC bus.
;
; - RAM_PORT/4
;
;   This bus is used for RAM port transfer. An 11-bit address is used where the
;   high 3 bits refer to the current RAM bank (CM-RAM-x signals) but the port
;   address (i.e. the RAM chip) has been sent in advance by the SRC bus.
;
; - MEM/4
;
;   This bus is used for RAM memory character transfer. An 11-bit address is
;   used where the high 3 bits refer to the current RAM bank (CM-RAM-x signals)
;   but the other parts of the address (i.e. chip, register and character) have
;   been sent in advance by the SRC bus.
;
; - STAT/4
;
;   This bus is used for RAM status character transfer. An 11-bit address is
;   used where the high 3 bits refer to the current RAM bank (CM-RAM-x signals)
;   and the low 2 bits refer to the status character. The other parts of the
;   address (i.e. chip and register) have been sent in advance by the SRC bus.
;
; - IO_x/1, IN_x/1, OUT_x/1
;
;   These buses represent the individual I/O pins (i.e. I/O, input or output
;   lines) of ROM, RAM and I/O chips. No address is used.
;
; For further documentation of the MCS-4, including a descripton of its actual
; bus concept, see /doc/MCS-4.txt//.


;------------------------------------------------------------------------------
;
;  General constants
;
;------------------------------------------------------------------------------


CONST IO_MODE(3)  ; 4001 ROM chip I/O line mode labels
{
    "output line (0 on read)",
    "output line (1 on read)",
    "input line"
}


CONST P(8)  ; 4004 CPU chip register pair names
{
    "0P", "1P", "2P", "3P", "4P", "5P", "6P", "7P"
}


;------------------------------------------------------------------------------
;
;  4001 ROM chip
;
;------------------------------------------------------------------------------


INTEL_4001 "Intel MCS-4 4001 256 x 8 bit 4 line I/O ROM chip (ROM image file)"

    #CHIP #ROM #INTEL #MCS-4 #4001

` This ROM component is part of the Intel MCS-4 Micro Computer Set and is
` intended to work with the 4004 CPU chip. Up to 16 ROM chips may be added to
` a single MCS-4 system while each ROM chip loads up to 256 bytes binary data
` from ROM_FILE which are mapped read only to address 000H-FFFH on the FETCH/8
` bus. In addition, each ROM chip has 4 lines where each line can be configured
` individually as an output line (selectable 0 or 1 on read) or an input line.
(
    ROM_FILE = "",  ; must be set by caller
    FETCH/8,        ; 8-bit fetch bus
    SRC,            ; send register control address bus
    ROM_PORT/4,     ; 4-bit ROM port read/write bus

    ;  I/O lines of ROM chip with individual I/O pin configurations:
    ; - mode value 0 represents an output line (0 is sent on read)
    ; - mode value 1 represents an output line (1 is sent on read)
    ; - any other mode value represents an input line
    ; This component translates PORT/4 reads and writes to multiple IO/1
    ; reads and writes.

    IO_0/1, IO_0_MODE = 0 (IO_MODE(0), IO_MODE(1), IO_MODE(2)),
    IO_1/1, IO_1_MODE = 0 (IO_MODE(0), IO_MODE(1), IO_MODE(2)),
    IO_2/1, IO_2_MODE = 0 (IO_MODE(0), IO_MODE(1), IO_MODE(2)),
    IO_3/1, IO_3_MODE = 0 (IO_MODE(0), IO_MODE(1), IO_MODE(2))
)
{
    $ROM/8(256) = $ROM_IMAGE(ROM_FILE, $INSTANCE * 256).

    VAR SRC_PORT/1.

[RESET]

    $CLEAR.  ; clear variables (note that $ROM/8 is not cleared)

[READ FETCH/8 =UINT/4($INSTANCE)nnnnnnnn]

    FETCH/8 = $ROM/8(n).

[SRC xxxiiiinnnn]

    SRC_PORT/1 = i == $INSTANCE.  ; set 1 if instance matches, 0 otherwise

[READ ROM_PORT/4]

    IF (SRC_PORT/1 == 1)
    {
        ROM_PORT/4 = 0.

        IF ((IO_0_MODE == 1) || ((IO_0_MODE > 1) && (IO_0/1 != 0)))
        {
            ROM_PORT/4 |= 0x1.
        }

        IF ((IO_1_MODE == 1) || ((IO_1_MODE > 1) && (IO_1/1 != 0)))
        {
            ROM_PORT/4 |= 0x2.
        }

        IF ((IO_2_MODE == 1) || ((IO_2_MODE > 1) && (IO_2/1 != 0)))
        {
            ROM_PORT/4 |= 0x4.
        }

        IF ((IO_3_MODE == 1) || ((IO_3_MODE > 1) && (IO_3/1 != 0)))
        {
            ROM_PORT/4 |= 0x8.
        }
    }

[WRITE ROM_PORT/4]

    IF (SRC_PORT/1 == 1)
    {
        IF (IO_0_MODE > 1)
        {
            IO_0/1 = ROM_PORT/4.
        }

        IF (IO_1_MODE > 1)
        {
            IO_1/1 = ROM_PORT/4 >> 1.
        }

        IF (IO_2_MODE > 1)
        {
            IO_2/1 = ROM_PORT/4 >> 2.
        }

        IF (IO_3_MODE > 1)
        {
            IO_3/1 = ROM_PORT/4 >> 3.
        }
    }
}


;------------------------------------------------------------------------------
;
;  4002 RAM bank (consists of 4 4002 chips)
;
;------------------------------------------------------------------------------


INTEL_4002_BANK "Intel MCS-4 4002 4 x 320 bit 4 x 4 line output RAM bank"

    #CHIP #RAM #INTEL #MCS-4 #4002

` This RAM component is part of the Intel MCS-4 Micro Computer Set and is
` intended to work with the 4004 CPU chip. Up to 8 RAM banks may be added to
` a single MCS-4 system while each RAM bank consists of 4 4002 chips, each
` providing 80 4-bit characters which are mapped to the MEM/4 bus using a
` special addressing concept. In addition, each RAM chip has 4 output lines,
` resulting in 16 output lines per RAM bank.
(
    SRC,         ; send register control address bus
    MEM/4,       ; 4-bit main memory character bus
    STAT/4,      ; 4-bit status character bus
    RAM_PORT/4,  ; 4-bit RAM port write bus

    ;  Output lines of RAM chips (4 each):

    OUT_0_0/1, OUT_0_1/1, OUT_0_2/1, OUT_0_3/1,  ; output lines of RAM chip 0
    OUT_1_0/1, OUT_1_1/1, OUT_1_2/1, OUT_1_3/1,  ; output lines of RAM chip 1
    OUT_2_0/1, OUT_2_1/1, OUT_2_2/1, OUT_2_3/1,  ; output lines of RAM chip 2
    OUT_3_0/1, OUT_3_1/1, OUT_3_2/1, OUT_3_3/1   ; output lines of RAM chip 3
)
{
    $RAM(4)  ; array of 4 individual 4002 RAM chips
    {
        REG(4) { MAIN_CHAR/4(16), STATUS_CHAR/4(4) }
    }

    VAR ADDR { CHIP/2, REG/2, CHAR/4 }

[RESET]

    $RAM_CLEAR.  ; clear RAM
    $CLEAR.      ; clear variables

[SRC =UINT/3($INSTANCE)ccrrnnnn]

    ; receive main character address from SRC (send register control) bus

    ADDR:CHIP/2 = c.
    ADDR:REG/2 = r.
    ADDR:CHAR/4 = n.

[READ MEM/4 =UINT/3($INSTANCE)xxxxxxxx]

    MEM/4 = $RAM(ADDR:CHIP/2):REG(ADDR:REG/2):MAIN_CHAR/4(ADDR:CHAR/4).

[WRITE MEM/4 =UINT/3($INSTANCE)xxxxxxxx]

    $RAM(ADDR:CHIP/2):REG(ADDR:REG/2):MAIN_CHAR/4(ADDR:CHAR/4) = MEM/4.

[READ STAT/4 =UINT/3($INSTANCE)xxxxxxnn]

    STAT/4 = $RAM(ADDR:CHIP/2):REG(ADDR:REG/2):STATUS_CHAR/4(n).

[WRITE STAT/4 =UINT/3($INSTANCE)xxxxxxnn]

    $RAM(ADDR:CHIP/2):REG(ADDR:REG/2):STATUS_CHAR/4(n) = STAT/4.

[WRITE RAM_PORT/4 =UINT/3($INSTANCE)xxxxxxxx]

    SELECT (ADDR:CHIP/2)
    {
    [0] OUT_0_0/1 = RAM_PORT/4.
        OUT_0_1/1 = RAM_PORT/4 >> 1.
        OUT_0_2/1 = RAM_PORT/4 >> 2.
        OUT_0_3/1 = RAM_PORT/4 >> 3.

    [1] OUT_1_0/1 = RAM_PORT/4.
        OUT_1_1/1 = RAM_PORT/4 >> 1.
        OUT_1_2/1 = RAM_PORT/4 >> 2.
        OUT_1_3/1 = RAM_PORT/4 >> 3.

    [2] OUT_2_0/1 = RAM_PORT/4.
        OUT_2_1/1 = RAM_PORT/4 >> 1.
        OUT_2_2/1 = RAM_PORT/4 >> 2.
        OUT_2_3/1 = RAM_PORT/4 >> 3.

    [3] OUT_3_0/1 = RAM_PORT/4.
        OUT_3_1/1 = RAM_PORT/4 >> 1.
        OUT_3_2/1 = RAM_PORT/4 >> 2.
        OUT_3_3/1 = RAM_PORT/4 >> 3.
    }
}


;------------------------------------------------------------------------------
;
;  4004 CPU
;
;------------------------------------------------------------------------------


CPU INTEL_4004 "Intel MCS-4 4004 CPU"

    #CHIP #CPU #INTEL #MCS-4 #4004

` This CPU component is part of the Intel MCS-4 Micro Computer Set and is
` intended to work with 4001 ROM chips, 4002 RAM banks and 4003 shift
` registers using most of the buses internally except the test input line
` TEST/1 which may be used at discretion. Other devices should be connected
` using the I/O lines of the 4001 ROM chips or output lines of the 4002 RAM
` banks.
(
    CLOCK_RATE = 740,  ; 740 kHz default clock rate (1.35 microseconds/cycle)
    ROM/8,             ; fetch bus
    SRC,               ; send register control address bus
    ROM_PORT/4,        ; ROM port read/write bus
    RAM_PORT/4,        ; RAM port write bus
    MEM/4,             ; main memory character bus
    STAT/4,            ; status character bus
    TEST/1             ; test input line of CPU chip
)
{
    ; registers:

    VAR A/4.        ; accumulator
    VAR CY/1.       ; carry flag (flip-flop)
    VAR REG/4(16).  ; 16 4-bit registers

    ; provide 8-bit access to register pairs:

    READ REG/8(x)
    {
        REG/8 = UINT/8(REG/4(2 * x), REG/4(2 * x + 1)).  ; high nibble first
    }

    WRITE REG/8(x)
    {
        UINT/8(REG/4(2 * x), REG/4(2 * x + 1)) = REG/8.  ; high nibble first
    }

    ; address stack and other CPU states:

    VAR RAM_BANK.  ; RAM bank currently selected by DCL instruction

    VAR ADDR_STACK_PTR/2.

    VAR ADDR_STACK/12(4).

    FETCH_ENTER
    {
        ADDR_STACK/12(ADDR_STACK_PTR/2) = $.
    }

[RESET]

    $CLEAR.  ; clear all CPU variables

    $CYCLE_FREQ = CLOCK_RATE.

    $FETCH/12(ROM/8).  ; 12-bit program counter, fetch from bus ROM/8

    $ = 0x000.  ; start fetching at address 000H

[FETCH 0000xxxx]

    FETCH_ENTER.

    IF (x == 0)
    {
        $COMMENT("no operation").
        $OPCODE("NOP").
    }
    ELSE
    {
        $OPCODE_INVALID.
    }

    $CYCLES(8).

[FETCH 0001nact llllllll]

    FETCH_ENTER.

    SELECT (UINT(n, a, c, t))
    {
    0b0000: $COMMENT("jump on condition (never)").
    0b1000: $COMMENT("jump on condition (always)").
    0b0100: $COMMENT("jump on condition (A == 0)").
    0b1100: $COMMENT("jump on condition (A != 0)").
    0b0010: $COMMENT("jump on condition (CY == 1)").
    0b1010: $COMMENT("jump on condition (CY == 0)").
    0b0001: $COMMENT("jump on condition (TEST == 0)").
    0b1001: $COMMENT("jump on condition (TEST == 1)").
    0b0110: $COMMENT("jump on condition (A == 0 or CY == 1)").
    0b1110: $COMMENT("jump on condition (A != 0 and CY == 0)").
    0b0101: $COMMENT("jump on condition (A == 0 or TEST == 0)").
    0b1101: $COMMENT("jump on condition (A != 0 and TEST == 1)").
    0b0011: $COMMENT("jump on condition (CY == 1 or TEST == 0)").
    0b1011: $COMMENT("jump on condition (CY == 0 and TEST == 1)").
    0b0111: $COMMENT("jump on condition (A == 0 or CY == 1 or TEST == 0)").
    0b1111: $COMMENT("jump on condition (A != 0 and CY == 0 and TEST == 1)").
    }

    $OPERAND($DEC(UINT(n, a, c, t))).
    $OPERAND(UINT/12($ >> 8, l)).
    $OPCODE("JCN").

    VAR T/1.

    T/1 = 0.

    IF ((t != 0) && (TEST/1(0) == 0))
    {
        T/1 |= 1.  ; test signal on bus TEST/1 is zero
    }

    IF ((c != 0) && (CY/1 == 1))
    {
        T/1 |= 1.  ; carry flag CY is set
    }

    IF ((a != 0) && (A/4 == 0))
    {
        T/1 |= 1.  ; accumulator A is zero
    }

    IF ((T/1 ^ n) != 0)
    {
        $ = UINT/12($ >> 8, l).  ; keep current ROM page
    }

    $CYCLES(16).

[FETCH 0010rrr0 dddddddd]

    FETCH_ENTER.

    $COMMENT("fetch immediate").
    $OPERAND(P(r)).
    $OPERAND($HEX(d)).
    $OPCODE("FIM").

    REG/8(r) = d.

    $CYCLES(16).

[FETCH 0010rrr1]

    FETCH_ENTER.

    $COMMENT("send register control").
    $OPERAND(P(r)).
    $OPCODE("SRC").

    SRC((RAM_BANK << 8) | REG/8(r)).

    $CYCLES(8).

[FETCH 0011rrr0]

    FETCH_ENTER.

    $COMMENT("fetch indirect").
    $OPERAND(P(r)).
    $OPCODE("FIN").

    REG/8(r) = ROM/8(UINT/12($ >> 8, REG/8(0))).  ; keep current ROM page

    $CYCLES(16).

[FETCH 0011rrr1]

    FETCH_ENTER.

    $COMMENT("jump indirect").
    $OPERAND(P(r)).
    $OPCODE("JIN").

    $ = UINT/12($ >> 8, REG/8(r)).  ; keep current ROM page

    $CYCLES(8).

[FETCH 0100hhhh llllllll]

    FETCH_ENTER.

    $COMMENT("jump unconditionally").
    $OPERAND($HEX(UINT/12(h, l))).
    $OPCODE("JUN").

    $ = UINT/12(h, l).

    $CYCLES(16).

[FETCH 0101hhhh llllllll]

    FETCH_ENTER.

    $COMMENT("jump to subroutine").
    $OPERAND($HEX(UINT/12(h, l))).
    $OPCODE("JMS").

    ADDR_STACK_PTR/2 += 1.  ; may overflow

    $ = UINT/12(h, l).

    $CYCLES(16).

[FETCH 0110rrrr]

    FETCH_ENTER.

    $COMMENT("increment register").
    $OPERAND(REG/4(r)).
    $OPCODE("INC").

    REG/4(r) += 1.  ; may overflow

    $CYCLES(8).

[FETCH 0111rrrr llllllll]

    FETCH_ENTER.

    $COMMENT("increment and skip if zero").
    $OPERAND(REG/4(r)).
    $OPERAND($HEX(UINT/12($ >> 8, l))).
    $OPCODE("ISZ").

    REG/4(r) += 1.  ; may overflow

    IF (REG/4(r) == 0)
    {
        $ = UINT/12($ >> 8, l).  ; keep current ROM page
    }

    $CYCLES(16).

[FETCH 1000rrrr]

    FETCH_ENTER.

    $COMMENT("add register to accumulator with carry").
    $OPERAND(REG/4(r)).
    $OPCODE("ADD").

    A/4 += REG/4(r) + CY/1.

    $FLAGS(CY/1, CF).

    $CYCLES(8).

[FETCH 1001rrrr]

    FETCH_ENTER.

    $COMMENT("subtract register from accumulator with borrow").
    $OPERAND(REG/4(r)).
    $OPCODE("SUB").

    A/4 += ~REG/4(r) + (CY/1 ^ 1).

    $FLAGS(CY/1, CF).

    $CYCLES(8).

[FETCH 1010rrrr]

    FETCH_ENTER.

    $COMMENT("load accumulator (from register)").
    $OPERAND(REG/4(r)).
    $OPCODE("LD").

    A/4 = REG/4(r).

    $CYCLES(8).

[FETCH 1011rrrr]

    FETCH_ENTER.

    $COMMENT("exchange register and accumulator").
    $OPERAND(REG/4(r)).
    $OPCODE("XCH").

    A/4 <> REG/4(r).

    $CYCLES(8).

[FETCH 1100dddd]

    FETCH_ENTER.

    $COMMENT("branch back and load").
    $OPERAND($HEX(d)).
    $OPCODE("BBL").

    ADDR_STACK_PTR/2 -= 1.  ; may underflow

    $ = ADDR_STACK/12(ADDR_STACK_PTR/2).

    A/4 = d.

    $CYCLES(8).

[FETCH 1101dddd]

    FETCH_ENTER.

    $COMMENT("load accumulator immediate").
    $OPERAND($HEX(d)).
    $OPCODE("LDM").

    A/4 = d.

    $CYCLES(8).

[FETCH 11100000]

    FETCH_ENTER.

    $COMMENT("write data RAM data character").
    $OPCODE("WRM").

    MEM/4(RAM_BANK << 8) = A/4.

    $CYCLES(8).

[FETCH 11100001]

    FETCH_ENTER.

    $COMMENT("write RAM port").
    $OPCODE("WMP").

    RAM_PORT/4(RAM_BANK << 8) = A/4.

    $CYCLES(8).

[FETCH 11100010]

    FETCH_ENTER.

    $COMMENT("write ROM port").
    $OPCODE("WRR").

    ROM_PORT/4 = A/4.

    $CYCLES(8).

[FETCH 11100010]

    FETCH_ENTER.

    $COMMENT("write program RAM (not implemented)").
    $OPCODE("WPM").

    $OPCODE_INVALID.

    $CYCLES(8).

[FETCH 111001ss]

    FETCH_ENTER.

    $COMMENT("write data RAM status character").

    SELECT(UINT/2(s))
    {
    0:  $OPCODE("WR0").
    1:  $OPCODE("WR1").
    2:  $OPCODE("WR2").
    3:  $OPCODE("WR3").
    }

    STAT/4((RAM_BANK << 8) | s) = A/4.

    $CYCLES(8).

[FETCH 11101000]

    FETCH_ENTER.

    $COMMENT("subtract data RAM from memory with borrow").
    $OPCODE("SBM").

    A/4 += ~MEM/4(RAM_BANK << 8) + (CY/1 ^ 1).

    $FLAGS(CY/1, CF).

    $CYCLES(8).

[FETCH 11101001]

    FETCH_ENTER.

    $COMMENT("read data RAM data character").
    $OPCODE("RDM").

    A/4 = MEM/4(RAM_BANK << 8).

    $CYCLES(8).

[FETCH 11101010]

    FETCH_ENTER.

    $COMMENT("read ROM port").
    $OPCODE("RDR").

    A/4 = ROM_PORT/4.

    $CYCLES(8).

[FETCH 11101011]

    FETCH_ENTER.

    $COMMENT("add data RAM to accumulator with carry").
    $OPCODE("ADM").

    A/4 += MEM/4(RAM_BANK << 8) + CY/1.

    $FLAGS(CY/1, CF).

    $CYCLES(8).

[FETCH 111011ss]

    FETCH_ENTER.

    $COMMENT("read data RAM status character").

    SELECT(UINT/2(s))
    {
    0:  $OPCODE("RD0").
    1:  $OPCODE("RD1").
    2:  $OPCODE("RD2").
    3:  $OPCODE("RD3").
    }

    A/4 = STAT/4((RAM_BANK << 8) | s).

    $CYCLES(8).

[FETCH 11110000]

    FETCH_ENTER.

    $COMMENT("clear both (accumulator and carry)").
    $OPCODE("CLB").

    A/4 = 0.
    CY/1 = 0.

    $CYCLES(8).

[FETCH 11110001]

    FETCH_ENTER.

    $COMMENT("clear carry").
    $OPCODE("CLC").

    CY/1 = 0.

    $CYCLES(8).

[FETCH 11110010]

    FETCH_ENTER.

    $COMMENT("increment accumulator").
    $OPCODE("IAC").

    A/4 += 1.

    $FLAGS(CY/1, CF).

    $CYCLES(8).

[FETCH 11110011]

    FETCH_ENTER.

    $COMMENT("complement carry").
    $OPCODE("CMC").

    CY/1 = ~CY/1.

    $CYCLES(8).

[FETCH 11110100]

    FETCH_ENTER.

    $COMMENT("complement accumulator").
    $OPCODE("CMA").

    A/4 = ~A/4.

    $CYCLES(8).

[FETCH 11110101]

    FETCH_ENTER.

    $COMMENT("rotate accumulator left through carry").
    $OPCODE("RAL").

    A/4 <<<= 1.  ; rotate without carry

    CY/1 ^= A/4.  ; swap least significand bit with carry
    A/4 ^= CY/1.
    CY/1 ^= A/4.

    $CYCLES(8).

[FETCH 11110110]

    FETCH_ENTER.

    $COMMENT("rotate accumulator right through carry").
    $OPCODE("RAR").

    CY/1 ^= A/4.  ; swap least significand bit with carry
    A/4 ^= CY/1.
    CY/1 ^= A/4.

    A/4 >>>= 1.  ; rotate without carry

    $CYCLES(8).

[FETCH 11110111]

    FETCH_ENTER.

    $COMMENT("transmit carry and clear").
    $OPCODE("TCC").

    A/4 = CY/1.
    CY/1 = 0.

    $CYCLES(8).

[FETCH 11111000]

    FETCH_ENTER.

    $COMMENT("decrement accumulator").
    $OPCODE("DAC").

    A/4 += 0xF.

    $FLAGS(CY/1, CF).

    $CYCLES(8).

[FETCH 11111001]

    FETCH_ENTER.

    $COMMENT("transfer carry substract").
    $OPCODE("TCS").

    A/4 = 9 + CY/1.
    CY/1 = 0.

    $CYCLES(8).

[FETCH 11111010]

    FETCH_ENTER.

    $COMMENT("set carry").
    $OPCODE("STC").

    CY/1 = 1.

    $CYCLES(8).

[FETCH 11111011]

    FETCH_ENTER.

    $COMMENT("decimal adjust accumulator").
    $OPCODE("DAA").

    IF (CY/1 || (A/4 > 9))
    {
        A/4 += 6.

        $FLAGS(CY/1, CF).
    }

    $CYCLES(8).

[FETCH 11111100]

    FETCH_ENTER.

    $COMMENT("keyboard process").
    $OPCODE("KBP").

    IF (A/4 == 0x4)
    {
        A/4 = 0x3.
    }
    ELIF (A/4 == 0x8)
    {
        A/4 = 0x4.
    }
    ELIF (A/4 > 2)
    {
        A/4 = 0xF.
    }

    $CYCLES(8).

[FETCH 11111101]

    FETCH_ENTER.

    $COMMENT("designate command line").
    $OPCODE("DCL").

    RAM_BANK = A/4.

    $CYCLES(8).

[FETCH 1111111x]

    FETCH_ENTER.

    $OPCODE_INVALID.

    $CYCLES(8).
}
