CPU Z80 "Zilog Z80 CPU"

    MEM/8,             ; 8-bit memory bus
    PORT/8,            ; 8-bit port bus
    INT,               ; interrupt request event bus
    NMI,               ; non-maskable interrupt request event bus
    CLOCK_RATE = 4000  ; 4 MHz default clock rate (0.25 microseconds/cycle)
{
    ; 8-bit registers:

    VAR REG/8(24)
        A', F', B', C', D', E', H', L',  ; shadow registers
        A,  F,  B,  C,  D,  E,  H,  L,   ; main registers
        IXh = 18, IXl, IYh, IYl, I, R.   ; special-purpose registers
    
    ; provide 16-bit access to REG/8:

    READ REG/16(x)
        AF', BC', DE', HL',  ; shadow registers
        AF,  BC,  DE,  HL,   ; main registers
        SP,  IX,  IY,  IR    ; special-purpose registers
    {
        REG/16 = UINT/16(REG/8(x * 2), REG/8(x * 2 + 1)).
    }

    WRITE REG/16(x)
        AF', BC', DE', HL',  ; shadow registers
        AF,  BC,  DE,  HL,   ; main registers
        SP,  IX,  IY,  IR    ; special-purpose registers
    {
        UINT/16(REG/8(x * 2), REG/8(x * 2 + 1)) = REG/16.
    }

    ; prefix and general opcode support:

    VAR PREFIX/2.  ; 0 = HL (default), 2 = IX (DD prefix), 3 = IY (FD prefix)

    ; opcode enter and leave macros:

    MACRO OPCODE_ENTER
    {
        ; emulate instruction fetch processing cycle (always called first by
        ; each handler so R will already be incremented):

        UINT/7(REG/8(R)) += 1.  ; increment low 7 bits of register R by 1
    }

    MACRO OPCODE_ENTER_ED
    {
        ; alternate instruction fetch processing cycle for CB-prefixed opcodes:

        UINT/7(REG/8(R)) += 2.  ; increment low 7 bits of register R by 2
    }

    MACRO OPCODE_ENTER_CB
    {
        ; alternate instruction fetch processing cycle for CB-prefixed opcodes
        ; (it seems that for such opcodes, a previous DD or FD prefix will NOT
        ; additionally increase R so we subtract the high bit of PREFIX/2 from
        ; 2 in order to increment the low 7 bits of register R by 1 rather than
        ; by 2 in such a case):

        UINT/7(REG/8(R)) += 2 - (PREFIX/2 >> 1).
    }

    MACRO OPCODE_LEAVE
    {
        PREFIX/2 = 0.  ; reset prefix
    }

    ; get 8-bit register index from x (0 = B, 1 = C, ..., 5 = L, 7 = A):

    READ GetReg8(x)
    {
        IF (x == 7)
        {
            REG_OFS_8 = 10.
        }
        ELIF (x <= 3)
        {
            REG_OFS_8 = x + 11.
        }
        ELSE
        {
            REG_OFS_8 = x + 11 + PREFIX/2 * 2.
        }
    }

    ; get 16-bit register index from x (0 = BC, 1 = DE, 2 = HL/IX/IY, 3 = SP):

    READ GetReg16(x)
    {
        IF (x != 2)
        {
            REG_OFS_16 = x + 5.
        }
        ELSE
        {
            REG_OFS_16 = x + 5 + PREFIX/2.
        }
    }

    ; provide 16-bit little endian data access to MEM/8:

    READ MEM/16(x)
    {
        MEM/16 = UINT/16(MEM/8(x), MEM/8(x + 1)).
    }

    WRITE MEM/16(x)
    {
        UINT/16(MEM/8(x), MEM/8(x + 1)) = MEM/16.
    }

    ; get effective memory address from (HL), (IX+d) or (IY+d) operands:

    READ MemAddr(s)
    {
        IF (PREFIX/2 == 0)
        {
            $OPCODE(s, "(HL)").

            MemAddr = REG/16(HL).
        }
        ELSE
        {
            $OPCODE("s", "(" REG/16(HL + PREFIX/2) SINT/8(MEM/8($)) ")").

            MemAddr = REG/16(HL + PREFIX/2) + SINT/8(MEM/8($)).

            $ += 1;

            $CYCLES(12).
        }
    }

RESET:

    ; init registers:

    REG/16(AF) = 0xFFFF.
    REG/16(SP) = 0xFFFF.
    REG/16(IR) = 0x0000.

    $FETCH/16(MEM/8).  ; 16-bit program counter, fetch from bus MEM/8

OPCODE 11011101:

    ; DD prefix (use IX):

    OPCODE_ENTER.
    PREFIX/2 = 2.       ; set prefix state to IX
    $CYCLES(4).
    $OPCODE_PREFIX.     ; expect actual instruction following (no OPCODE_LEAVE)

OPCODE 11111101:

    ; FD prefix (use IY):

    OPCODE_ENTER.
    PREFIX/2 = 3.       ; set prefix state to IY
    $CYCLES(4).
    $OPCODE_PREFIX.     ; expect actual instruction following (no OPCODE_LEAVE)

OPCODE 00000000:

    ; NOP

    OPCODE_ENTER.
    $COMMENT("no operation").
    $OPCODE("NOP").
    $CYCLES(4).
    OPCODE_LEAVE.

OPCODE 00rr0001 llllllll hhhhhhhh:

    ; LD BC/DE/HL/IX/IY/SP,nn

    OPCODE_ENTER.
    $COMMENT("16-bit register load").
    $OPCODE("LD", REG/16(GetReg16(r)), UINT/16(h, l).

    REG/16(GetReg16(r)) = UINT/16(h, l).

    $CYCLES(10).
    OPCODE_LEAVE.

OPCODE 000r0010:

    ; LD (BC/DE),A

    OPCODE_ENTER.
    $COMMENT("write A to memory by register indirect").
    $OPCODE("LD", "(" REG/16(BC + r) ")", "A".

    MEM/8(REG/16(BC + r)) = REG/8(A).

    $CYCLES(7).
    OPCODE_LEAVE.

OPCODE 00100010 llllllll hhhhhhhh:

    ; LD (nn),HL/IX/IY

    OPCODE_ENTER.
    $COMMENT("write index register to memory").
    $OPCODE("LD", "(" UINT/16(h, l) ")", REG/16(GetReg16(2)).

    MEM/16(UINT/16(h, l)) = REG/16(GetReg16(2)).

    $CYCLES(16).
    OPCODE_LEAVE.

OPCODE 00110010 llllllll hhhhhhhh:

    ; LD (nn),A

    OPCODE_ENTER.
    $COMMENT("write A to memory").
    $OPCODE("LD", "(" UINT/16(h, l) ")", "A".

    MEM/8(UINT/16(h, l)) = REG/8(A).

    $CYCLES(13).
    OPCODE_LEAVE.

OPCODE 00rr0011:

    ; INC BC/DE/HL/IX/IY/SP

    OPCODE_ENTER.
    $COMMENT("16-bit register increment").
    $OPCODE("INC", REG/16(GetReg16(r)).

    REG/16(GetReg16(r)) += UINT/16(1).

    $CYCLES(6).
    OPCODE_LEAVE.

OPCODE 00rrr100:

    ; INC A/B/C/D/E/H/L
    ; INC (HL)/(IX+d)/(IY+d)

    OPCODE_ENTER.

    IF (r != 6)
    {
        $COMMENT("8-bit register increment").
        $OPCODE("INC", REG/8(GetReg8(r))).

        REG/8(GetReg8(r)) += 1.

        $CYCLES(4).
    }
    ELSE
    {
        $COMMENT("8-bit memory increment").

        MEM/8(MemAddr("INC")) += 1.

        $CYCLES(11).
    }

    $FLAGS(REG/8(F), SF, ZF, & 0x20, AF, & 0x08, == 0x80, 0, -).
    OPCODE_LEAVE.

OPCODE 00rrr101:

    ; DEC A/B/C/D/E/H/L
    ; DEC (HL)/(IX+d)/(IY+d)

    OPCODE_ENTER.

    IF (r != 6)
    {
        $COMMENT("8-bit register decrement").
        $OPCODE("DEC", REG/8(GetReg8(r))).

        REG/8(GetReg8(r)) -= 1.

        $CYCLES(4).
    }
    ELSE
    {
        $COMMENT("8-bit memory decrement").

        MEM/8(MemAddr("DEC")) -= 1.

        $CYCLES(11).
    }

    $FLAGS(REG/8(F), SF, ZF, & 0x20, AF, & 0x08, == 0x80, 1, -).
    OPCODE_LEAVE.

OPCODE 00rrr110 nnnnnnnn:

    ; LD A/B/C/D/E/H/L,n
    ; LD (HL)/(IX+d)/(IY+d),n

    OPCODE_ENTER.

    IF (r != 6)
    {
        $COMMENT("8-bit register increment").
        $OPCODE("INC", REG/8(GetReg8(r))).

        REG/8(GetReg8(r)) += 1.

        $CYCLES(4).
    }
    ELSE
    {
        $COMMENT("8-bit memory increment").

        MEM/8(MemAddr("INC")) += 1.

        $CYCLES(11).
    }

    $FLAGS(REG/8(F), SF, ZF, & 0x20, AF, & 0x08, == 0x80, 0, -).
    OPCODE_LEAVE.

OPCODE 11010011 nnnnnnnn:

    PORT/8(REG/8(A) << 8 | UINT/8(n)) = REG/8(A).  ; OUT (n),A

INT:

    ; interrupt

NMI:

    ; non-maskable interrupt
}
