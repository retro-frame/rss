CPU Z80 "Zilog Z80 CPU"

    MEM/8,   ; 8-bit memory bus
    PORT/8,  ; 8-bit port bus
    INT,     ; interrupt request event bus
    NMI      ; non-maskable interrupt request event bus
{
    ; 8-bit registers:

    VAR REG/8(25)
        A', F', B', C', D', E', H', L',  ; shadow registers
        A,  F,  B,  C,  D,  E,  H,  L,   ; main registers
        I = 22, R.                       ; special registers

    ; provide 16-bit access to REG/8:

    GET REG/16(x)
        AF', BC', DE', HL',  ; shadow registers
        AF,  BC,  DE,  HL,   ; main registers
        SP,  IX,  IY         ; stack pointer and index registers
    {
        REG/16 = REG/8(x * 2) | REG/8(x * 2 + 1) << 8.
    }

    PUT REG/16(x)
        AF', BC', DE', HL',  ; shadow registers
        AF,  BC,  DE,  HL,   ; main registers
        SP,  IX,  IY         ; stack pointer and index registers
    {
        REG/8(x * 2) = REG/16.
        REG/8(x * 2 + 1) = REG/16 >> 8.
    }

    ; provide 16-bit little endian data access to MEM/8:

    GET MEM/16(x)
    {
        MEM/16 = MEM/8(x) | MEM/8(x + 1) << 8.
    }

    PUT MEM/16(x)
    {
        MEM/8(x) = MEM/16.
        MEM/8(x + 1) = MEM/16 >> 8.
    }

    ; memory refresh register R increment routine:

    DEF INC_R
    {
        REG/8(R) = (REG/8(R) & 80H) | ((REG/8(R) + 1) & 7FH).
    }

RESET:

    ; init registers:

    REG/16(AF) = 0xFFFF.
    REG/16(SP) = 0xFFFF.
    REG/16(IR) = 0x0000.

    $OPCODE_FETCH(MEM/8(16)).  ; 16-bit program counter, fetch from bus MEM/8

OPCODE:

    REG/8(R) += 1.  ; increment R register (high bit is stored separately)

OPCODE 00000000:

    ; NOP:

    .

OPCODE 00rr0001 llllllll hhhhhhhh:

    ; LD BC/DE/HL/SP,n:

    REG/16(BC + UINT/16(r)) = UINT/16(l) | UINT/16(h) << 8.

OPCODE 000r0010:

    ; LD BC/DE,A:

    MEM/8(REG/16(BC + UINT/16(r) << 1)) = REG/8(A).

OPCODE 00rr0011:

    REG/16(BC + UINT/16(r) << 1) += 1.  ; INC BC/DE/HL/SP

OPCODE 00rrr100:

    IF (UINT/8(r) != 06H)
    {
        REG/8(A + (UINT/8(r) + 1) & 0x07) += 1.  ; INC A/B/C/D/E/H/L
    }
    ELSE
    {
        MEM/8(REG/16(HL)) += 1.  ; INC (HL)
    }

    REG/8(F) = $FLAGS/8(SF, ZF, ?, AF, ?, ==0x80, 0, ?).

OPCODE 00rrr101:

    IF (UINT/8(r) != 06H)
    {
        REG/8(A + (UINT/8(r) + 1) & 0x07) -= 1.  ; DEC A/B/C/D/E/H/L
    }
    ELSE
    {
        MEM/8(REG/16(HL)) -= 1.  ; DEC (HL)
    }

    REG/8(F) = $FLAGS/8(SF, ZF, ?, AF, ?, ==0x7F, 1, ?).

OPCODE 00rrr110 nnnnnnnn:

    IF (UINT/8(r) != 0x06)
    {
        REG/8(A + (UINT/8(r) + 1) & 0x07) = UINT/8(n).  ; LD A/B/C/D/E/H/L,n
    }
    ELSE
    {
        MEM/8(REG/16(HL)) = UINT/8(n).  ; LD (HL),n
    }

OPCODE 11010011 nnnnnnnn:

    PORT/8(REG/8(A) << 8 | UINT/8(n)) = REG/8(A).  ; OUT (n),A

INT:

    ; interrupt

NMI:

    ; non-maskable interrupt
}
